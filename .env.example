# Public URL of the FastAPI API running beside your Discord bot
BOT_API_URL=https://YOUR-BOT-API-DOMAIN.example.com

# Shared secret used only by Vercel server routes -> bot API
DASHBOARD_SHARED_SECRET=CHANGE_ME_LONG_RANDOM_SECRET

# Discord OAuth2 application credentials (keep secret private)
DISCORD_CLIENT_ID=1550847674222387200
DISCORD_CLIENT_SECRET=YOUR_DISCORD_APPLICATION_CLIENT_SECRET
# Exact HTTPS callback URL registered in Discord Developer Portal
DISCORD_REDIRECT_URI=https://YOUR-VERCEL-DOMAIN.vercel.app/api/auth/callback

# Separate signing secret for the dashboard login cookie
DASHBOARD_SESSION_SECRET=CHANGE_ME_ANOTHER_LONG_RANDOM_SECRET
